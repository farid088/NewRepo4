#region Task6
int eded1 = 10;
int eded2 = 5;
string simvol = Console.ReadLine();
while (simvol != "+" && simvol != "-" && simvol != "*" && simvol != "/")
{
    simvol = Console.ReadLine();
}
if (simvol == "*")
{
    Console.WriteLine(eded1 * eded2);
}
else if (simvol == "+")
{
    Console.WriteLine(eded1 + eded2);
}
else if (simvol == "-")
{
    Console.WriteLine(eded1 - eded2);
}
else 
{
    Console.WriteLine(eded1 / eded2);
}
#endregion
