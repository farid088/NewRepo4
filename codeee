#region TAsk5
//Verilmiş yazılar siyahısında verilmiş hərfdən neçə ədəd olduğunu tapan proqram
string herf = "e";
string[] yazilar = { "salam", "necesen", "elm" };
int countt = 0;
for (int b=0;b<yazilar.Length;b++)
{
    for(int c = 0; c < yazilar[b].Length; c++)
    {
        if (yazilar[b][c].ToString() == herf)
        {
            countt++;
        }
    }
}
